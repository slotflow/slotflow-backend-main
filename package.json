{
  "name": "slotflow-main-backend",
  "description": "slotflow mian backend service",
  "author": "midhunkalarikkal",
  "license": "MIT",
  "version": "1.0.0",
  "main": "src/server.ts",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 4000",
    "dev": "tsx watch src/server.ts",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "type:check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "bundle": "tsup src/server.ts --format esm --dts --out-dir dist-bundle",
    "validate": "tsc --noEmit && pnpm lint:check && pnpm format:check && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.772.0",
    "@codebymk/validator": "^1.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/instrumentation-winston": "^0.58.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@opentelemetry/winston-transport": "^0.24.0",
    "@upstash/redis": "^1.35.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.1",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "figlet": "^1.11.0",
    "gaxios": "^8.2.0",
    "googleapis": "^160.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "moment": "^2.30.1",
    "mongoose": "^8.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "stripe": "^17.7.0",
    "uuid": "^11.1.0",
    "validator": "^13.12.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.15.32",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/validator": "^13.12.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "otp-generator-module": "^1.0.2",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
